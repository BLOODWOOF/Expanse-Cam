# Passes the cam's live data, video setup and the server map through to the page.
# Publishing (/cam/whip) is never exposed, and nothing on 127.0.0.1:8081 (ads admin, mod)
# is ever proxied.
{
	admin off
	auto_https off
}

# routes shared by the public port and the dev site
(routes) {
	handle /cam/reader.js {
		reverse_proxy 127.0.0.1:8889
	}

	@whep path /cam/whep /cam/whep/*
	handle @whep {
		reverse_proxy 127.0.0.1:8889
	}

	@api {
		path /api/*
		method GET HEAD
	}
	# the page itself is on GitHub Pages, so let it read these
	handle @api {
		reverse_proxy 127.0.0.1:8090 {
			header_down Access-Control-Allow-Origin "https://bloodwoof.github.io"
			header_down Vary Origin
		}
	}

	# Quick tunnels hold server-sent events back, so Pl3xmap's live updates never arrive.
	# Refusing them makes the map fall back to polling straight away.
	handle /map/sse* {
		respond 404
	}

	# Pl3xmap has no CORS headers and no https, so the map and claims go through here
	@mapget {
		path /map/*
		method GET HEAD
	}
	handle @mapget {
		uri strip_prefix /map
		reverse_proxy http://185.206.150.11:8117 {
			header_up Host 185.206.150.11:8117
			header_down Access-Control-Allow-Origin "https://bloodwoof.github.io"
			header_down Vary Origin
		}
	}

	handle /cam/* {
		respond 404
	}
	handle /api/* {
		respond 405
	}
	handle /map/* {
		respond 405
	}
}

# public, reached through the Cloudflare quick tunnel
:8080 {
	# other websites can't use the stream or the live data
	@foreign {
		path /api/* /cam/*
		header Origin *
		not header Origin https://bloodwoof.github.io
	}
	handle @foreign {
		respond 403
	}

	import routes

	# the page lives on GitHub Pages, not here
	handle {
		redir https://bloodwoof.github.io/Expanse-Cam/ 302
	}
}

# dev site, this PC only
http://127.0.0.1:8082 {
	import routes

	handle {
		root * "{$DEV_SITE_DIR}"
		header Cache-Control no-cache
		file_server
	}
}
