	"description": "Parks the camera on a slow pan for streaming the server",
	"authors": [
		"BLOODWOLF"
	],
	"license": "All-Rights-Reserved",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.lambda.expansecam.ExpanseCamClient"
